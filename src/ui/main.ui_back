  <property name="styleSheet">
   <string notr="true">/* Estilo general */
QWidget {
    background-color: #f5f5f5;
    color: #000000;
    font-family: Arial, sans-serif;
    font-size: 12px;
}

/* Ventana principal */
QMainWindow {
    background-color: #f5f5f5;
}

/* Menús y barras de herramientas */
QMenuBar {
    background-color: #f0f0f0;
    border-bottom: 1px solid #cccccc;
}

QMenuBar::item {
    spacing: 5px;
    padding: 3px 8px;
    background: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: #e6e6e6;
}

QMenuBar::item:pressed {
    background: #d9d9d9;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #cccccc;
}

QMenu::item {
    padding: 5px 30px 5px 20px;
    border: 1px solid transparent;
}

QMenu::item:selected {
    background-color: #e6f2ff;
    border-color: #3399ff;
}

QMenu::separator {
    height: 1px;
    background: #e0e0e0;
    margin: 4px 10px;
}

/* Barras de herramientas */
QToolBar {
    background-color: #f0f0f0;
    border-bottom: 1px solid #cccccc;
    padding: 2px;
    spacing: 1px;
}

QToolBar::separator {
    width: 1px;
    background-color: #cccccc;
    margin: 3px 6px;
}

QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 3px;
    margin: 1px;
}

QToolBar QToolButton:hover {
    background-color: #e6e6e6;
    border: 1px solid #cccccc;
}

QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background-color: #d0d0d0;
    border: 1px solid #999999;
}

/* Botones estándar */
QPushButton {
    background-color: #e6e6e6;
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding: 6px 12px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #d9d9d9;
}

QPushButton:pressed {
    background-color: #d0d0d0;
    border: 1px solid #999999;
}

QPushButton:disabled {
    background-color: #f5f5f5;
    color: #9E9E9E;
    border: 1px solid #e0e0e0;
}

/* Botones especiales */
QPushButton#primaryButton {
    background-color: #3399ff;
    color: white;
    border: 1px solid #0066cc;
}

QPushButton#primaryButton:hover {
    background-color: #0066cc;
}

QPushButton#successButton {
    background-color: #4CAF50;
    color: white;
    border: 1px solid #2E7D32;
}

QPushButton#dangerButton {
    background-color: #F44336;
    color: white;
    border: 1px solid #C62828;
}

/* Paneles, Frames y GroupBox */
QFrame {
    border: 1px solid #cccccc;
    border-radius: 3px;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 5px;
    margin-top: 15px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    background-color: transparent;
    padding: 5px;
    color: #333333;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #cccccc;
    border-radius: 3px;
    top: -1px;
}

QTabBar::tab {
    background-color: #e6e6e6;
    border: 1px solid #cccccc;
    padding: 5px 10px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    border-bottom-color: #ffffff;
}

QTabBar::tab:hover:!selected {
    background-color: #f0f0f0;
}

/* Listas, tablas y vistas */
QListView, QTreeView, QTableView {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    selection-background-color: #e6f2ff;
    selection-color: #000000;
    alternate-background-color: #f9f9f9;
}

QHeaderView::section {
    background-color: #e6e6e6;
    border: 1px solid #cccccc;
    padding: 4px;
    font-weight: bold;
}

/* ComboBox (desplegables) */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding: 3px 18px 3px 5px;
    min-width: 6em;
}

QComboBox:hover {
    border: 1px solid #3399ff;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;
    border-left: 1px solid #cccccc;
}

/* SpinBox (selectores numéricos) */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding: 3px 5px;
}

/* Checkbox */
QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #cccccc;
    border-radius: 2px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #3399ff;
    border-color: #0066cc;
}

/* Radio Button */
QRadioButton::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #cccccc;
    border-radius: 7px;
    background-color: #ffffff;
}

QRadioButton::indicator:checked {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.4, fx:0.5, fy:0.5, stop:0 #3399ff, stop:1 #ffffff);
    border-color: #0066cc;
}

/* Campos de texto */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding: 3px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #3399ff;
}

/* Sliders (deslizadores) */
QSlider::groove:horizontal {
    border: 1px solid #cccccc;
    height: 6px;
    background: #e6e6e6;
    border-radius: 3px;
    margin: 2px 0;
}

QSlider::handle:horizontal {
    background: #3399ff;
    border: 1px solid #0066cc;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

/* ProgressBar (barras de progreso) */
QProgressBar {
    border: 1px solid #cccccc;
    border-radius: 3px;
    background-color: #e6e6e6;
    text-align: center;
    padding: 1px;
}

QProgressBar::chunk {
    background-color: #3399ff;
    width: 10px;
    margin: 0.5px;
}

/* Barras de desplazamiento */
QScrollBar:horizontal {
    border: 1px solid #cccccc;
    background: #f5f5f5;
    height: 15px;
    margin: 0px 15px 0 15px;
}

QScrollBar::handle:horizontal {
    background: #d0d0d0;
    min-width: 30px;
    border-radius: 3px;
}

QScrollBar:vertical {
    border: 1px solid #cccccc;
    background: #f5f5f5;
    width: 15px;
    margin: 15px 0 15px 0;
}

QScrollBar::handle:vertical {
    background: #d0d0d0;
    min-height: 30px;
    border-radius: 3px;
}

/* ToolTips */
QToolTip {
    background-color: #ffffd0;
    border: 1px solid #ccccaa;
    border-radius: 3px;
    padding: 5px;
    color: #333333;
    font-size: 11px;
}

/* Barra de estado */
QStatusBar {
    background-color: #f0f0f0;
    color: #333333;
    border-top: 1px solid #cccccc;
}

/* Estilos para señales */
QLabel[class=&quot;ECGSignal&quot;] {
    color: #ff6666;
}

QLabel[class=&quot;EEGSignal&quot;] {
    color: #6666ff;
}

QLabel[class=&quot;EMGSignal&quot;] {
    color: #66cc66;
}

QLabel[class=&quot;SpiroSignal&quot;] {
    color: #ff9933;
}

/* Estilos para toolbars agrupados */
QFrame[frameShape=&quot;5&quot;] {  /* 5 es VLine */
    color: #cccccc;
    width: 1px;
    height: 20px;
    margin: 2px 8px;
}

/* Títulos de grupos en toolbars */
QToolBar QLabel.group-title {
    font-size: 10px;
    color: #666666;
    background: transparent;
    padding: 0px 4px;
    margin-bottom: -2px;
}</string>
